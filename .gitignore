# ---------------------------------------------------------------------- #
# Basic C++ and CMake Project .gitignore
# ---------------------------------------------------------------------- #

# 1. Build Directory
# The 'build' directory contains ALL generated files (executables, object files,
# caches, etc.) and should always be ignored to keep the repository clean.
/build/
build/

# 2. CMake Generated Files (Cache and temporary)
# These files are generated by CMake and are not necessary for source control.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
.cmake/

# 3. Compiled Object and Library Files
# Ignore common compiler outputs, regardless of where they are created.
*.o
*.obj
*.lo
*.la
*.slo
*.mod

# Executables
*.exe
*.out
*.app
*.bin
*.dll
*.so
*.dylib

# 4. IDE and Editor Files
# Ignore files specific to popular IDEs/Editors that store user settings/state.
# Visual Studio / Visual Studio Code
.vs/
.vscode/
*.sln
*.vcxproj
*.user
*.suo

# CLion / JetBrains IDEs
.idea/
cmake-build-*/

# Vim/Neovim swap files
*~
*.swp
*.swo

# macOS
.DS_Store